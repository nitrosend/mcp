{
  "name": "nitrosend-mcpb",
  "version": "1.0.1",
  "description": "Nitrosend Desktop Extension — connects Claude Desktop to the Nitrosend remote MCP server with browser OAuth",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Nitrosend",
    "email": "contact@nitrosend.com",
    "url": "https://nitrosend.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nitrosend/claude.git",
    "directory": "mcpb"
  },
  "main": "server/index.js",
  "scripts": {
    "test": "node --test",
    "pack": "mcpb pack . dist/nitrosend.mcpb",
